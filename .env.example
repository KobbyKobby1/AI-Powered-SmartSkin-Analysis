# Copy this file to .env.local and fill in real values.
# Every NEXT_PUBLIC_* value is inlined into the static build and is readable by
# anyone who opens devtools. Do not put real secrets here — only public keys and
# public endpoints. Real secrets belong on the payment backend.

# Orbo skin-analysis API (only used by the live/remote analysis path)
# Development: https://dev.api.ghanaskinanalysis.orbo.tech/api
# Production:  https://api.ghanaskinanalysis.orbo.tech/api
NEXT_PUBLIC_ORBO_BASE_URL=https://dev.api.ghanaskinanalysis.orbo.tech/api
NEXT_PUBLIC_ORBO_CLIENT_KEY=

# SmartSkin payment/contact backend
# Local development: http://localhost:5890/payment
# Production:        https://payment.smartskinafrica.com/payment
NEXT_PUBLIC_PAYMENT_BASE_URL=https://payment.smartskinafrica.com/payment
NEXT_PUBLIC_PAYMENT_API_KEY=
